%{
#include <stdio.h>
#include <string.h>
#include "ast.h"     /* Add this line */
#include "y.tab.h"  /* Will be generated by bison */

/* Function to handle string literals */
char* process_string(char* yytext);
%}

%option noyywrap
%option yylineno

/* State definitions */
%x STRING_STATE
%x COMMENT_STATE
%x MULTILINE_COMMENT_STATE

%%

"ASSESSMENT"        { return ASSESSMENT; }
"SECTION"           { return SECTION; }
"MC_QUESTION"       { return MC_QUESTION; }
"TF_QUESTION"       { return TF_QUESTION; }
"OPTION"            { return OPTION; }
"ANSWER"            { return ANSWER; }
"FEEDBACK"          { return FEEDBACK; }
"IF_SCORE"          { return IF_SCORE; }
"ABOVE"             { return ABOVE; }
"BELOW"             { return BELOW; }
"CORRECT"           { return CORRECT; }
"INCORRECT"         { return INCORRECT; }
"TRUE"              { return TRUE_VAL; }
"FALSE"             { return FALSE_VAL; }

"{"                 { return '{'; }
"}"                 { return '}'; }

[0-9]+              { yylval.num = atoi(yytext); return NUMBER; }

[ \t\n\r]+          ; /* Skip whitespace */

\"                  { BEGIN(STRING_STATE); yylval.str = strdup(""); } /* Start collecting a string */

"//"                { BEGIN(COMMENT_STATE); } /* Single-line comment */
"/*"                { BEGIN(MULTILINE_COMMENT_STATE); } /* Multi-line comment */

.                   { printf("Lexical error: Unexpected character %s at line %d\n", yytext, yylineno); }

<STRING_STATE>\"    { 
                      BEGIN(INITIAL); 
                      return STRING; 
                    }
<STRING_STATE>\\\"  { yylval.str = realloc(yylval.str, strlen(yylval.str) + 2);
                      strcat(yylval.str, "\""); }
<STRING_STATE>\\\\ { yylval.str = realloc(yylval.str, strlen(yylval.str) + 2);
                      strcat(yylval.str, "\\"); }
<STRING_STATE>\\n  { yylval.str = realloc(yylval.str, strlen(yylval.str) + 2);
                      strcat(yylval.str, "\n"); }
<STRING_STATE>[^\"\\\n]+ { 
                      yylval.str = realloc(yylval.str, strlen(yylval.str) + strlen(yytext) + 1);
                      strcat(yylval.str, yytext);
                    }

<COMMENT_STATE>\n   { BEGIN(INITIAL); }
<COMMENT_STATE>.    { /* Eat comment characters */ }

<MULTILINE_COMMENT_STATE>"*/" { BEGIN(INITIAL); }
<MULTILINE_COMMENT_STATE>.|\n { /* Eat comment characters */ }

%%

/* Helper function to process string literals */
char* process_string(char* text) {
    int len = strlen(text);
    char* result = malloc(len - 1);
    strncpy(result, text + 1, len - 2);
    result[len - 2] = '\0';
    return result;
}